# Postgres credentials — distinct roles so RLS actually applies
# (the app role must NOT be the schema owner, see db/schema.sql)
PG_ADMIN_PASSWORD=
PG_APP_PASSWORD=

# Signing secret shared by PostgREST and the API's JWT issuance (self-hosted GoTrue shim)
JWT_SECRET=

# Google AI / Maps
GEMINI_API_KEY=
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# Public base URL this stack is served from (used as the Vite build-time Supabase URL)
PUBLIC_URL=http://YOUR_VM_EXTERNAL_IP
